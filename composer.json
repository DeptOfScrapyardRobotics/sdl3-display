{
    "name": "dept-of-scrapyard-robotics/sdl3-display",
    "description": "Drive SDL3-powered Windows with PHP",
    "license": "MIT",
    "homepage": "https://scrapyard-io.projectsaturnstudios.com",
    "version": "0.6.2",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-sdl3": "^0.5.0",
        "microscrap/sdl3": "^0.5.0",
        "microscrap/sdl3-gfx": "^0.6.0",
        "fabricate/displays": "^0.6.0",
        "fabricate/contracts": "^0.6.0",
        "fabricate/nuts-and-bolts": "^0.6.0"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "autoload": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Displays\\SDL3\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "extra": {
        "branch-alias": {
            "dev-master": "0.6.x-dev"
        },
        "scrapyard-io": {
            "providers": [
                "DeptOfScrapyardRobotics\\Displays\\SDL3\\Providers\\SDL3DisplayServiceProvider"
            ]
        }
    }
}
